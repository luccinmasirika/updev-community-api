// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  DELETED
  PENDING
  DISABLED
}

enum Sex {
  M
  F
}

enum Role {
  ADMIN
  USER
  AUTHOR
}

enum PostType {
  ARTICLE
  QUESTION
}

model User {
  id               String        @id @default(cuid())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  firstName        String
  lastName         String
  email            String        @unique
  password         String
  accountStatus    AccountStatus @default(PENDING)
  confirmationCode String?       @unique
  role             Role
  profile          Profile?      @relation(fields: [profileId], references: [id])
  profileId        String?
  files            Files?        @relation(fields: [filesId], references: [id])
  filesId          String?
  posts            Post[]

  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  avatar    Files?   @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fileId    String?
  bio       String?  @db.Text
  website   String?
  country   String
  town      String
  sex       Sex?
  phone     Phone    @relation(fields: [phoneId], references: [id])
  facebook  String?
  twitter   String?
  linkedIn  String?
  gitHub    String?
  phoneId   String
  users     User[]

  @@map("profiles")
}

model Phone {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  code      String    @default("+243")
  number    String?   @unique
  profiles  Profile[]
}

model Post {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  title       String
  content     String     @db.Text
  type        PostType
  slug        String     @unique
  draft       Boolean    @default(false)
  publishedOn DateTime   @default(now())
  author      User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId      String
  tags        PostTags[]
  article     Article?   @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  articleId   String?
  question    Question?  @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  questionId  String?

  @@map("posts")
}

model PostTags {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  postId    String
  tag       Tags     @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tagId     String

  @@map("posts-tags")
}

model Tags {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     PostTags[]
  name      String

  @@unique([name])
  @@map("tags")
}

model Article {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  image     Files?   @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fileId    String?
  posts     Post[]

  @@map("articles")
}

model Question {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  @@map("questions")
}

model Files {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  name      String
  width     Int?
  height    Int?
  size      Int
  mime      String
  url       String
  users     User[]
  profiles  Profile[]
  articles  Article[]

  @@map("files")
}
