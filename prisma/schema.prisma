// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  DELETED
  PENDING
  DISABLED
}

enum Sex {
  M
  F
}

enum Role {
  ADMIN
  USER
  AUTHOR
}

enum PostType {
  ARTICLE
  QUESTION
}

enum ArticleReactionType {
  LIKE
  LOVE
  USEFUL
}

enum QuestionReactionType {
  LIKE
  DISLIKE
}

enum CommentReactionType {
  LIKE
  DISLIKE
}

enum NotificationType {
  COMMENT
  REPLY
  LIKE
  DISLIKE
  BOOKMARK
  SHARE
  FOLLOW
  LOVE
  USEFUL
}

enum Locale {
  EN
  FR
}

model User {
  id                   String             @id @default(cuid())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  firstName            String
  lastName             String
  email                String             @unique
  username             String?            @unique
  password             String
  accountStatus        AccountStatus      @default(ACTIVE)
  role                 Role
  profile              Profile?           @relation(fields: [profileId], references: [id])
  profileId            String?
  files                Files?             @relation(fields: [filesId], references: [id])
  filesId              String?
  posts                Post[]
  comments             PostComment[]
  articleReactions     ArticleReaction[]
  bookmarks            PostBookmark[]
  questionReactions    QuestionReaction[]
  notificationToUser   Notification[]     @relation("NotificationToUser")
  notificationFromUser Notification[]     @relation("NotificationFromUser")
  followedTags         FollowTags[]
  commentReactions     CommentReaction[]
  followings           FollowAuthors[]    @relation("Followings")
  followers            FollowAuthors[]    @relation("Followers")
  views                PostViews[]
  authorRequest        AuthorRequest[]
  series               Series[]

  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  avatar    Files?   @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fileId    String?
  bio       String?  @db.Text
  website   String?
  country   String?
  town      String?
  sex       Sex?
  phone     String?
  facebook  String?
  twitter   String?
  linkedIn  String?
  gitHub    String?
  job       String?
  users     User[]

  @@map("profiles")
}

model Post {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  title         String
  content       String         @db.Text
  type          PostType
  locale        Locale         @default(FR)
  slug          String         @unique
  draft         Boolean        @default(false)
  publishedOn   DateTime       @default(now())
  author        User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId        String
  tags          PostTags[]
  article       Article?       @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  articleId     String?
  question      Question?      @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  questionId    String?
  comments      PostComment[]
  bookmarks     PostBookmark[]
  notifications Notification[]
  views         PostViews[]
  series        Series?        @relation(fields: [seriesId], references: [id])
  seriesId      String?

  @@index([slug])
  @@map("posts")
}

model Series {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String
  slug        String   @unique
  description String?  @db.Text
  author      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId      String
  image       Files?   @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fileId      String?
  posts       Post[]

  @@index([slug])
  @@map("series")
}

model PostViews {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String

  @@map("posts-views")
}

model PostTags {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  postId    String
  tag       Tags     @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tagId     String

  @@map("posts-tags")
}

model PostComment {
  id               String            @id @default(cuid())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  post             Post              @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  postId           String
  content          String            @db.Text
  author           User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId           String
  parentComment    PostComment?      @relation("parentCommentRelation", fields: [parentCommentId], references: [id])
  parentCommentId  String?
  depth            Int               @default(0)
  childrenComments PostComment[]     @relation("parentCommentRelation")
  notifications    Notification[]
  reactions        CommentReaction[]

  @@map("comments")
}

model FollowTags {
  id      String @id @default(cuid())
  tag     Tags   @relation(fields: [tagName], references: [name], onDelete: Cascade, onUpdate: Cascade)
  tagName String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId  String

  @@unique([userId, tagName])
  @@index([userId])
  @@map("follow-tags")
}

model FollowAuthors {
  id       String @id @default(cuid())
  author   User   @relation("Followings", fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorId String
  user     User   @relation("Followers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId   String

  @@unique([authorId, userId])
  @@index([userId, authorId])
  @@map("follow-authors")
}

model Tags {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  posts     PostTags[]
  name      String
  followers FollowTags[]

  @@unique([name])
  @@map("tags")
}

model Article {
  id        String            @id @default(cuid())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  image     Files?            @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fileId    String?
  published Boolean           @default(true)
  posts     Post[]
  reactions ArticleReaction[]

  @@map("articles")
}

model ArticleReaction {
  id        String              @id @default(cuid())
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  article   Article             @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  articleId String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String
  type      ArticleReactionType

  @@unique([articleId, userId])
  @@map("article-reactions")
}

model QuestionReaction {
  id         String               @id @default(cuid())
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  question   Question             @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  questionId String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String
  type       QuestionReactionType

  @@unique([questionId, userId])
  @@map("question-reactions")
}

model CommentReaction {
  id        String              @id @default(cuid())
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  comment   PostComment         @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  commentId String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String
  type      CommentReactionType

  @@unique([commentId, userId])
  @@map("comment-reactions")
}

model PostBookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String

  @@unique([postId, userId])
  @@map("post-bookmarks")
}

model Question {
  id        String             @id @default(cuid())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  published Boolean            @default(true)
  posts     Post[]
  reactions QuestionReaction[]

  @@map("questions")
}

model Notification {
  id                   String           @id @default(cuid())
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  notificationToUser   User             @relation("NotificationToUser", fields: [toUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  toUserId             String
  notificationFromUser User             @relation("NotificationFromUser", fields: [fromUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fromUserId           String
  type                 NotificationType
  post                 Post?            @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  postId               String?
  comment              PostComment?     @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  commentId            String?
  read                 Boolean          @default(false)

  @@map("notifications")
}

model Files {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  name      String
  width     Int?
  height    Int?
  size      Int
  mime      String
  url       String
  users     User[]
  profiles  Profile[]
  articles  Article[]
  Series    Series[]

  @@map("files")
}

model AuthorRequest {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String
  status    RequestStatus

  @@unique([userId])
  @@map("author-requests")
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}
