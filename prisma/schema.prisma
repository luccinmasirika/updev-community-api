// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  DELETED
  PENDING
  DISABLED
}

enum Sex {
  M
  F
}

enum Role {
  ADMIN
  USER
  AUTHOR
}

enum PostType {
  ARTICLE
  QUESTION
}

enum ArticleReactionType {
  LIKE
  LOVE
  USEFUL
}

enum QuestionReactionType {
  LIKE
  DISLIKE
}

enum NotificationType {
  COMMENT
  REPLY
  LIKE
  DISLIKE
  BOOKMARK
  SHARE
  FOLLOW
  LOVE
  USEFUL
}

model User {
  id                   String             @id @default(cuid())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  firstName            String
  lastName             String
  email                String             @unique
  username             String?            @unique
  password             String
  accountStatus        AccountStatus      @default(ACTIVE)
  role                 Role
  profile              Profile?           @relation(fields: [profileId], references: [id])
  profileId            String?
  files                Files?             @relation(fields: [filesId], references: [id])
  filesId              String?
  posts                Post[]
  comments             PostComment[]
  articleReactions     ArticleReaction[]
  bookmarks            PostBookmark[]
  questionReactions    QuestionReaction[]
  notificationToUser   Notification[]     @relation("NotificationToUser")
  notificationFromUser Notification[]     @relation("NotificationFromUser")

  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  avatar    Files?   @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fileId    String?
  bio       String?  @db.Text
  website   String?
  country   String?
  town      String?
  sex       Sex?
  phone     String?
  facebook  String?
  twitter   String?
  linkedIn  String?
  gitHub    String?
  job       String?
  users     User[]

  @@map("profiles")
}

